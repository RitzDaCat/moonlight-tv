--- /dev/null
+++ b/tests/unit/test_fec_encoder_cache.cpp
@@ -0,0 +1,76 @@
+/**
+ * @file tests/unit/test_fec_encoder_cache.cpp
+ * @brief Verify cached FEC coefficients remain wire-compatible and bounded.
+ */
+#include <climits>
+#include <gtest/gtest.h>
+#include <src/fec_encoder_cache.h>
+#include <vector>
+
+/** @brief Initialize the same finite-field implementation used by the host. */
+class FecEncoderCache: public testing::Test {
+protected:
+  /** @brief Initialize FEC arithmetic before constructing coefficient matrices. */
+  static void SetUpTestSuite() {
+    reed_solomon_init();
+  }
+};
+
+TEST_F(FecEncoderCache, RejectsInvalidDimensionsWithoutMutatingCache) {
+  stream::fec::rs_cache_t cache;
+  for (const auto [data, parity] : {std::pair {0, 1}, {1, 0}, {-1, 1}, {1, -1}, {255, 1}, {1, 255}, {INT_MAX, INT_MAX}}) {
+    EXPECT_THROW(cache.get(data, parity), std::invalid_argument);
+  }
+  EXPECT_EQ(cache.size(), 0);
+}
+
+TEST_F(FecEncoderCache, ReusesRecentlyUsedEntriesAndRemainsBounded) {
+  stream::fec::rs_cache_t cache;
+  auto *first = cache.get(16, 4);
+  EXPECT_EQ(first, cache.get(16, 4));
+  for (int data = 17; data < 24; ++data) {
+    cache.get(data, 4);
+  }
+  EXPECT_EQ(cache.size(), 8);
+  EXPECT_EQ(first, cache.get(16, 4));
+  cache.get(24, 4);  // Evicts 17/4, preserving the promoted 16/4 entry.
+  EXPECT_EQ(first, cache.get(16, 4));
+  EXPECT_EQ(cache.size(), 8);
+}
+
+TEST_F(FecEncoderCache, MatchesFreshParityAcrossHitsEvictionsAndDifferentPayloads) {
+  stream::fec::rs_cache_t cache;
+  for (int pass = 0; pass < 3; ++pass) {
+    for (int shape = 1; shape < 12; ++shape) {
+      const int data = shape * 16;
+      const int parity = shape * 3;
+      constexpr int bytes = 1024;
+      std::vector<unsigned char> reference((data + parity) * bytes), cached(reference.size());
+      for (int i = 0; i < data * bytes; ++i) {
+        reference[i] = static_cast<unsigned char>(i * 37 + pass * 101 + shape);
+      }
+      cached = reference;
+      std::vector<unsigned char *> a(data + parity), b(data + parity);
+      for (int i = 0; i < data + parity; ++i) {
+        a[i] = reference.data() + i * bytes;
+        b[i] = cached.data() + i * bytes;
+      }
+      std::unique_ptr<reed_solomon, stream::fec::rs_deleter_t> fresh {reed_solomon_new(data, parity)};
+      ASSERT_NE(fresh, nullptr);
+      ASSERT_EQ(reed_solomon_encode(fresh.get(), a.data(), data + parity, bytes), 0);
+      ASSERT_EQ(reed_solomon_encode(cache.get(data, parity), b.data(), data + parity, bytes), 0);
+      EXPECT_EQ(reference, cached) << shape << ": " << pass;
+      // Exercise the hit path on another payload, without rebuilding coefficients.
+      b[data][0] ^= 0x55;
+      ASSERT_EQ(reed_solomon_encode(cache.get(data, parity), b.data(), data + parity, bytes), 0);
+      EXPECT_EQ(reference, cached);
+      EXPECT_LE(cache.size(), 8);
+    }
+  }
+}
+
+TEST_F(FecEncoderCache, AcceptsMaximumValidTotalShardCount) {
+  stream::fec::rs_cache_t cache;
+  EXPECT_NE(cache.get(254, 1), nullptr);
+  EXPECT_NE(cache.get(1, 254), nullptr);
+}
