+/**
+ * @file src/fec_encoder_cache.h
+ * @brief Bounded sender-owned cache of Reed-Solomon coefficient matrices.
+ */
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <memory>
+#include <rs.h>
+#include <stdexcept>
+
+namespace stream::fec {
+  /**
+   * @brief Release a cached Reed-Solomon encoder.
+   */
+  struct rs_deleter_t {
+    /** @brief Release encoder storage. @param encoder Encoder to release. */
+    void operator()(reed_solomon *encoder) const {
+      reed_solomon_release(encoder);
+    }
+  };
+
+  /**
+   * @brief Reuse up to eight coefficient matrices on one video sender thread.
+   *
+   * Entries use a small MRU index list instead of an unbounded map. Encoder use
+   * finishes before the next lookup; callers must not retain the returned pointer
+   * across another lookup. This class is intentionally not shared between threads.
+   */
+  class rs_cache_t {
+  public:
+    /**
+     * @brief Find or initialize coefficients for a validated FEC block shape.
+     * @param data_shards Number of data shards.
+     * @param parity_shards Number of parity shards.
+     * @return Encoder owned by this cache until a later lookup evicts it.
+     */
+    reed_solomon *get(int data_shards, int parity_shards) {
+      if (data_shards <= 0 || parity_shards <= 0 || data_shards > DATA_SHARDS_MAX || parity_shards > DATA_SHARDS_MAX || data_shards + parity_shards > DATA_SHARDS_MAX) {
+        throw std::invalid_argument("Invalid Reed-Solomon shard counts");
+      }
+      for (std::size_t i = 0; i < used; ++i) {
+        auto index = order[i];
+        auto &entry = entries[index];
+        if (entry.data_shards == data_shards && entry.parity_shards == parity_shards) {
+          promote(i, index);
+          return entry.encoder.get();
+        }
+      }
+      // Construct before eviction so an allocation failure leaves the cache intact.
+      std::unique_ptr<reed_solomon, rs_deleter_t> encoder {reed_solomon_new(data_shards, parity_shards)};
+      if (!encoder) {
+        throw std::bad_alloc();
+      }
+      const auto index = used < entries.size() ? used : order[used - 1];
+      if (used < entries.size()) {
+        ++used;
+      }
+      entries[index] = {data_shards, parity_shards, std::move(encoder)};
+      promote(used - 1, index);
+      return entries[index].encoder.get();
+    }
+
+    /** @brief Return the number of cached coefficient matrices. */
+    std::size_t size() const {
+      return used;
+    }
+
+  private:
+    /** @brief One immutable coefficient matrix and its dimensions. */
+    struct entry_t {
+      int data_shards = 0;  ///< Data shard count.
+      int parity_shards = 0;  ///< Parity shard count.
+      std::unique_ptr<reed_solomon, rs_deleter_t> encoder;  ///< Owned matrix.
+    };
+
+    /**
+     * @brief Move an entry to the MRU end without allocation or a wrapping clock.
+     * @param position Previous index in the MRU ordering.
+     * @param index Entry to promote.
+     */
+    void promote(std::size_t position, std::size_t index) {
+      while (position > 0) {
+        order[position] = order[position - 1];
+        --position;
+      }
+      order[0] = index;
+    }
+
+    std::array<entry_t, 8> entries;  ///< Bounded encoder storage.
+    std::array<std::size_t, 8> order {};  ///< Most recently used entry first.
+    std::size_t used = 0;  ///< Number of initialized entries.
+  };
+}  // namespace stream::fec
