+/**
+ * @file src/platform/linux/pipewire_buffer_lease.h
+ * @brief Bounded PipeWire buffer ownership, protected by the caller's thread-loop lock.
+ */
+#pragma once
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace pipewire_lease {
+  /** @brief A generation-checked read ownership token; it never dereferences its buffer. */
+  struct ticket {
+    void *buffer = nullptr;  ///< Opaque buffer identity.
+    std::uint64_t generation = 0;  ///< Monotonic registration identity.
+    unsigned slot = 0;  ///< Fixed pool slot for constant-time release.
+  };
+
+  /** @brief A fixed-capacity ownership ledger with no allocation on buffer delivery. */
+  class pool {
+  public:
+    static constexpr unsigned capacity = 32;  ///< Hard limit above the negotiated producer buffer count.
+
+    /** @brief Result of accepting a delivered producer buffer. */
+    struct delivery {
+      bool accepted = false;  ///< Whether the new current buffer was installed.
+      void *retired = nullptr;  ///< Previous unused buffer the caller can return to the producer.
+    };
+
+    /**
+     * @brief Install a new latest buffer while preserving all active readers.
+     * @param buffer Newly dequeued, uniquely owned producer buffer.
+     * @return Acceptance status and an unused previous buffer eligible for return.
+     */
+    delivery accept(void *buffer) {
+      if (!buffer || next_generation == std::numeric_limits<std::uint64_t>::max()) {
+        return {};
+      }
+      unsigned free = capacity;
+      for (unsigned i = 0; i < capacity; ++i) {
+        if (entries[i].buffer == buffer) {
+          return {};
+        }
+        if (!entries[i].buffer && free == capacity) {
+          free = i;
+        }
+      }
+      if (free == capacity && current < capacity && entries[current].readers == 0) {
+        free = current;
+      }
+      if (free == capacity) {
+        return {};
+      }
+      void *retired = retire_current();
+      entries[free] = {buffer, ++next_generation, 0};
+      current = free;
+      return {true, retired};
+    }
+
+    /**
+     * @brief Pin the latest buffer until its consumer finishes reading.
+     * @return A token for this registration, or empty when there is no current buffer.
+     */
+    std::optional<ticket> pin_current() {
+      if (current == capacity || entries[current].readers == std::numeric_limits<unsigned>::max()) {
+        return std::nullopt;
+      }
+      auto &entry = entries[current];
+      ++entry.readers;
+      return ticket {entry.buffer, entry.generation, current};
+    }
+
+    /**
+     * @brief Release one read token without touching removed or re-registered buffers.
+     * @param token Token acquired exactly once by the consumer.
+     * @return A no-longer-current buffer eligible for producer reuse, or null.
+     */
+    void *release(const ticket &token) {
+      if (token.slot >= capacity) {
+        return nullptr;
+      }
+      auto &entry = entries[token.slot];
+      if (entry.buffer != token.buffer || entry.generation != token.generation || entry.readers == 0) {
+        return nullptr;
+      }
+      if (--entry.readers == 0 && current != token.slot) {
+        void *buffer = entry.buffer;
+        entry = {};
+        return buffer;
+      }
+      return nullptr;
+    }
+
+    /**
+     * @brief Stop advertising the latest buffer while preserving outstanding readers.
+     * @return An unused current buffer eligible for producer return, or null.
+     */
+    void *retire_current() {
+      if (current == capacity) {
+        return nullptr;
+      }
+      auto &entry = entries[current];
+      current = capacity;
+      if (entry.readers != 0) {
+        return nullptr;
+      }
+      void *buffer = entry.buffer;
+      entry = {};
+      return buffer;
+    }
+
+    /**
+     * @brief Invalidate a removed producer buffer before its address can be reused.
+     * @param buffer Removed opaque producer buffer.
+     */
+    void remove(void *buffer) {
+      for (unsigned i = 0; i < capacity; ++i) {
+        if (entries[i].buffer == buffer) {
+          entries[i] = {};
+          if (current == i) {
+            current = capacity;
+          }
+        }
+      }
+    }
+
+    /** @brief Detach all registrations at stream destruction, retaining the generation counter. */
+    void clear() {
+      entries = {};
+      current = capacity;
+    }
+
+    /**
+     * @brief Check whether a delivered pointer is still held by this ledger.
+     * @param buffer Producer buffer identity, never dereferenced.
+     * @return Whether a live registration owns the buffer.
+     */
+    bool contains(void *buffer) const {
+      for (const auto &entry : entries) {
+        if (entry.buffer && entry.buffer == buffer) {
+          return true;
+        }
+      }
+      return false;
+    }
+
+    /**
+     * @brief Inspect the latest dequeued buffer without acquiring read ownership.
+     * @return Current opaque buffer identity, or null.
+     */
+    void *latest() const {
+      return current < capacity ? entries[current].buffer : nullptr;
+    }
+
+  private:
+    /** @brief One producer registration and its active reader count. */
+    struct entry {
+      void *buffer = nullptr;  ///< Producer buffer identity.
+      std::uint64_t generation = 0;  ///< Never reused within this stream owner.
+      unsigned readers = 0;  ///< Number of outstanding read tokens.
+    };
+
+    std::array<entry, capacity> entries {};  ///< Bounded registrations, including retired readers.
+    unsigned current = capacity;  ///< Current slot or the invalid sentinel.
+    std::uint64_t next_generation = 0;  ///< New registration counter, preserved across clearing.
+  };
+}  // namespace pipewire_lease
