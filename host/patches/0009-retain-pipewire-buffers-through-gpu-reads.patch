+/**
+ * @file tests/unit/platform/linux/test_pipewire_buffer_lease.cpp
+ * @brief Ownership, pointer reuse, bounded capacity and pause/removal transitions.
+ */
+#include "src/platform/linux/pipewire_buffer_lease.h"
+
+#include <gtest/gtest.h>
+
+/** @brief Hold an old buffer until its last reader returns, while latest-only delivery advances. */
+TEST(PipewireBufferLease, PreventsReuseWhileAnyReaderRemains) {
+  pipewire_lease::pool pool;
+  int first, second, third;
+  EXPECT_FALSE(pool.pin_current());
+  EXPECT_EQ(pool.retire_current(), nullptr);
+  EXPECT_FALSE(pool.accept(nullptr).accepted);
+  ASSERT_TRUE(pool.accept(&first).accepted);
+  auto a = pool.pin_current(), b = pool.pin_current();
+  ASSERT_TRUE(a);
+  ASSERT_TRUE(b);
+  auto delivered = pool.accept(&second);
+  EXPECT_TRUE(delivered.accepted);
+  EXPECT_EQ(delivered.retired, nullptr);
+  EXPECT_EQ(pool.release(*a), nullptr);
+  EXPECT_EQ(pool.latest(), &second);
+  delivered = pool.accept(&third);
+  EXPECT_TRUE(delivered.accepted);
+  EXPECT_EQ(delivered.retired, &second);
+  EXPECT_EQ(pool.release(*b), &first);
+  EXPECT_EQ(pool.release(*b), nullptr);
+  EXPECT_EQ(pool.retire_current(), &third);
+  EXPECT_EQ(pool.latest(), nullptr);
+}
+
+/** @brief Reject duplicate deliveries and stale tokens after address reuse, removal or teardown. */
+TEST(PipewireBufferLease, RejectsStaleRegistrationsWithoutDoubleQueueing) {
+  pipewire_lease::pool pool;
+  int buffer;
+  ASSERT_TRUE(pool.accept(&buffer).accepted);
+  auto old = pool.pin_current();
+  ASSERT_TRUE(old);
+  EXPECT_FALSE(pool.accept(&buffer).accepted);
+  EXPECT_TRUE(pool.contains(&buffer));
+  EXPECT_FALSE(pool.contains(nullptr));
+  pool.remove(&buffer);
+  EXPECT_EQ(pool.latest(), nullptr);
+  EXPECT_FALSE(pool.contains(&buffer));
+  ASSERT_TRUE(pool.accept(&buffer).accepted);
+  auto current = pool.pin_current();
+  ASSERT_TRUE(current);
+  EXPECT_NE(old->generation, current->generation);
+  EXPECT_EQ(pool.release(*old), nullptr);
+  EXPECT_EQ(pool.retire_current(), nullptr);
+  EXPECT_EQ(pool.release(*current), &buffer);
+  ASSERT_TRUE(pool.accept(&buffer).accepted);
+  current = pool.pin_current();
+  ASSERT_TRUE(current);
+  pool.clear();
+  ASSERT_TRUE(pool.accept(&buffer).accepted);
+  EXPECT_EQ(pool.release(*current), nullptr);
+  EXPECT_EQ(pool.latest(), &buffer);
+  auto invalid = *old;
+  invalid.slot = pipewire_lease::pool::capacity;
+  EXPECT_EQ(pool.release(invalid), nullptr);
+  pool.remove(nullptr);
+  EXPECT_EQ(pool.retire_current(), &buffer);
+}
+
+/** @brief Pause preserves active ownership and avoids starving the next producer buffer. */
+TEST(PipewireBufferLease, RetiresPausedReadersAndReusesUnpinnedSlots) {
+  pipewire_lease::pool pool;
+  std::array<int, pipewire_lease::pool::capacity + 1> buffers {};
+  std::array<pipewire_lease::ticket, pipewire_lease::pool::capacity> tickets {};
+  for (unsigned i = 0; i < pool.capacity; ++i) {
+    ASSERT_TRUE(pool.accept(&buffers[i]).accepted);
+    tickets[i] = *pool.pin_current();
+  }
+  EXPECT_FALSE(pool.accept(&buffers.back()).accepted);
+  EXPECT_EQ(pool.latest(), &buffers[pool.capacity - 1]);
+  EXPECT_EQ(pool.retire_current(), nullptr);
+  EXPECT_EQ(pool.release(tickets[0]), &buffers[0]);
+  ASSERT_TRUE(pool.accept(&buffers.back()).accepted);
+  for (unsigned i = 1; i < pool.capacity; ++i) {
+    EXPECT_EQ(pool.release(tickets[i]), &buffers[i]);
+  }
+  EXPECT_EQ(pool.retire_current(), &buffers.back());
+  // A full ledger can reuse its current unpinned slot atomically.
+  for (unsigned i = 0; i < pool.capacity; ++i) {
+    ASSERT_TRUE(pool.accept(&buffers[i]).accepted);
+    if (i + 1 < pool.capacity) {
+      tickets[i] = *pool.pin_current();
+    }
+  }
+  auto replacement = pool.accept(&buffers.back());
+  EXPECT_TRUE(replacement.accepted);
+  EXPECT_EQ(replacement.retired, &buffers[pool.capacity - 1]);
+}
+
+/** @brief Repeated three-buffer cycles never let a producer overwrite a held frame. */
+TEST(PipewireBufferLease, SustainsProducerConsumerReuseAndGenerations) {
+  pipewire_lease::pool pool;
+  std::array<int, 3> pixels {};
+  std::array<bool, 3> producer_owned {true, true, true};
+  auto returned = [&](void *p) {
+    if (p) {
+      const auto index = static_cast<int *>(p) - pixels.data();
+      ASSERT_FALSE(producer_owned[index]);
+      producer_owned[index] = true;
+    }
+  };
+  for (int frame = 0; frame < 10000; ++frame) {
+    const unsigned index = frame % pixels.size();
+    ASSERT_TRUE(producer_owned[index]);
+    pixels[index] = frame;
+    producer_owned[index] = false;
+    auto next = pool.accept(&pixels[index]);
+    ASSERT_TRUE(next.accepted);
+    returned(next.retired);
+    auto read = pool.pin_current();
+    ASSERT_TRUE(read);
+    EXPECT_EQ(*static_cast<int *>(read->buffer), frame);
+    returned(pool.release(*read));
+  }
+  returned(pool.retire_current());
+  for (bool owned : producer_owned) {
+    EXPECT_TRUE(owned);
+  }
+}
