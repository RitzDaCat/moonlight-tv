diff --git a/tests/unit/test_nvenc_split_mode.cpp b/tests/unit/test_nvenc_split_mode.cpp
new file mode 100644
index 0000000..e519249
--- /dev/null
+++ b/tests/unit/test_nvenc_split_mode.cpp
@@ -0,0 +1,35 @@
+/**
+ * @file tests/unit/test_nvenc_split_mode.cpp
+ * @brief Check split-frame policy names against the linked HEVC/AV1 encoders.
+ */
+#if !defined(__ANDROID__) && !defined(__APPLE__)
+  #include <gtest/gtest.h>
+  #include <src/nvenc/nvenc_config.h>
+extern "C" {
+  #include <libavcodec/avcodec.h>
+  #include <libavutil/opt.h>
+}
+
+TEST(NvencSplitMode, MapsPublicPolicyWithoutDependingOnFFmpegEnumNumbers) {
+  using enum nvenc::nvenc_split_frame_encoding;
+  EXPECT_STREQ(nvenc::ffmpeg_split_encode_mode(disabled), "disabled");
+  EXPECT_STREQ(nvenc::ffmpeg_split_encode_mode(driver_decides), "auto");
+  EXPECT_STREQ(nvenc::ffmpeg_split_encode_mode(force_enabled), "forced");
+  EXPECT_STREQ(nvenc::ffmpeg_split_encode_mode(static_cast<nvenc::nvenc_split_frame_encoding>(-1)), "auto");
+}
+
+TEST(NvencSplitMode, EveryModeResolvesForBothSupportedCodecs) {
+  for (const auto name : {"hevc_nvenc", "av1_nvenc"}) {
+    const AVCodec *codec = avcodec_find_encoder_by_name(name);
+    if (codec == nullptr) {
+      GTEST_SKIP() << name << " is not available";
+    }
+    AVCodecContext *context = avcodec_alloc_context3(codec);
+    ASSERT_NE(context, nullptr);
+    for (const auto mode : {nvenc::nvenc_split_frame_encoding::disabled, nvenc::nvenc_split_frame_encoding::driver_decides, nvenc::nvenc_split_frame_encoding::force_enabled}) {
+      EXPECT_EQ(av_opt_set(context->priv_data, "split_encode_mode", nvenc::ffmpeg_split_encode_mode(mode), 0), 0) << name;
+    }
+    avcodec_free_context(&context);
+  }
+}
+#endif
