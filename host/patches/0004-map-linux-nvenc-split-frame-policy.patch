+   * @return Named FFmpeg split_encode_mode value; unknown values retain auto mode.
+   */
+  constexpr const char *ffmpeg_split_encode_mode(nvenc_split_frame_encoding mode) {
+    switch (mode) {
+      case nvenc_split_frame_encoding::disabled:
+        return "disabled";
+      case nvenc_split_frame_encoding::force_enabled:
+        return "forced";
+      default:
+        return "auto";
+    }
+  }
