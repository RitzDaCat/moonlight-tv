+namespace {
+  /**
+   * @brief Output served by the fake compositor.
+   */
+  struct fake_output_t {
+    bool supported;  ///< Whether the output reports power mode support.
+    std::uint32_t mode;  ///< Current power mode.
+    bool obeys;  ///< Whether the output changes mode when asked.
+    std::vector<std::uint32_t> requests {};  ///< Modes the client asked for.
+  };
+
+  /**
+   * @brief Record a requested power mode and apply it if the output obeys.
+   *
+   * @param client Client that sent the request.
+   * @param resource DPMS object of the output.
+   * @param mode Requested power mode.
+   */
+  void dpms_set(wl_client *client, wl_resource *resource, std::uint32_t mode) {
+    auto output = static_cast<fake_output_t *>(wl_resource_get_user_data(resource));
+    output->requests.push_back(mode);
+    if (output->obeys) {
+      output->mode = mode;
+      org_kde_kwin_dpms_send_mode(resource, mode);
+      org_kde_kwin_dpms_send_done(resource);
+    }
+  }
+
+  /**
+   * @brief Destroy a DPMS object.
+   *
+   * @param client Client that sent the request.
+   * @param resource DPMS object to destroy.
+   */
+  void dpms_release(wl_client *client, wl_resource *resource) {
+    wl_resource_destroy(resource);
+  }
+
+  const struct org_kde_kwin_dpms_interface dpms_implementation {
+    .set = dpms_set,
+    .release = dpms_release,
+  };  ///< Requests of a DPMS object.
+
+  /**
+   * @brief Create a DPMS object and report the power state of its output, like KWin does.
+   *
+   * @param client Client that sent the request.
+   * @param manager DPMS manager.
+   * @param id Id of the new DPMS object.
+   * @param output Output the DPMS object controls.
+   */
+  void dpms_get(wl_client *client, wl_resource *manager, std::uint32_t id, wl_resource *output) {
+    auto state = static_cast<fake_output_t *>(wl_resource_get_user_data(output));
+    auto dpms = wl_resource_create(client, &org_kde_kwin_dpms_interface, wl_resource_get_version(manager), id);
+    wl_resource_set_implementation(dpms, &dpms_implementation, state, nullptr);
+    org_kde_kwin_dpms_send_supported(dpms, state->supported);
+    org_kde_kwin_dpms_send_mode(dpms, state->mode);
+    org_kde_kwin_dpms_send_done(dpms);
+  }
+
+  const struct org_kde_kwin_dpms_manager_interface dpms_manager_implementation {
+    .get = dpms_get,
+  };  ///< Requests of the DPMS manager.
+
+  /**
+   * @brief Bind an output.
+   *
+   * @param client Client binding the output.
+   * @param data Output state.
+   * @param version Version requested by the client.
+   * @param id Id of the new output object.
+   */
+  void bind_output(wl_client *client, void *data, std::uint32_t version, std::uint32_t id) {
+    auto output = wl_resource_create(client, &wl_output_interface, version, id);
+    wl_resource_set_implementation(output, nullptr, data, nullptr);
+  }
+
+  /**
+   * @brief Bind the DPMS manager.
+   *
+   * @param client Client binding the manager.
+   * @param data Unused.
+   * @param version Version requested by the client.
+   * @param id Id of the new manager object.
+   */
+  void bind_dpms_manager(wl_client *client, void *data, std::uint32_t version, std::uint32_t id) {
+    auto manager = wl_resource_create(client, &org_kde_kwin_dpms_manager_interface, version, id);
+    wl_resource_set_implementation(manager, &dpms_manager_implementation, nullptr, nullptr);
+  }
+
+  /**
+   * @brief Run wl::wake_outputs() against a compositor serving on another thread.
+   *
+   * @param outputs Outputs to serve; they record the client's requests.
+   * @param dpms Whether to serve KWin's DPMS manager.
+   */
+  void wake_outputs_on(std::vector<fake_output_t> &outputs, bool dpms) {
+    auto display = wl_display_create();
+    for (auto &output : outputs) {
+      wl_global_create(display, &wl_output_interface, 1, &output, bind_output);
+    }
+    if (dpms) {
+      wl_global_create(display, &org_kde_kwin_dpms_manager_interface, 1, nullptr, bind_dpms_manager);
+    }
+
+    auto socket = std::filesystem::temp_directory_path() / ("sunshine-test-wayland-" + std::to_string(getpid()));  // NOSONAR(cpp:S5443): safe for tests
+    if (wl_display_add_socket(display, socket.c_str())) {
+      wl_display_destroy(display);
+      FAIL() << "Couldn't listen on " << socket;
+    }
+
+    std::atomic_bool running {true};
+    std::thread compositor {[display, &running]() {
+      while (running) {
+        wl_display_flush_clients(display);
+        wl_event_loop_dispatch(wl_display_get_event_loop(display), -1);
+      }
+    }};
+
+    {
+      test_utils::env_restore_t restore {"WAYLAND_DISPLAY"};
+      lizardbyte::common::set_env("WAYLAND_DISPLAY", socket.string());
+      wl::wake_outputs();
+    }
+
+    running = false;
+    wl_display_terminate(display);
+    compositor.join();
+    wl_display_destroy(display);
+  }
+}  // namespace
+
+TEST(WaylandWakeOutputsTest, TurnsOnOutputsThatAreOff) {
+  std::vector<fake_output_t> outputs {
+    {.supported = true, .mode = ORG_KDE_KWIN_DPMS_MODE_OFF, .obeys = true},
+    {.supported = true, .mode = ORG_KDE_KWIN_DPMS_MODE_STANDBY, .obeys = true},
+    {.supported = true, .mode = ORG_KDE_KWIN_DPMS_MODE_ON, .obeys = true},
+    {.supported = false, .mode = ORG_KDE_KWIN_DPMS_MODE_OFF, .obeys = true},
+  };
+
+  wake_outputs_on(outputs, true);
+
+  const std::vector<std::uint32_t> on {ORG_KDE_KWIN_DPMS_MODE_ON};
+  EXPECT_EQ(outputs[0].requests, on);
+  EXPECT_EQ(outputs[1].requests, on);
+  EXPECT_TRUE(outputs[2].requests.empty());
+  EXPECT_TRUE(outputs[3].requests.empty());
+}
+
+TEST(WaylandWakeOutputsTest, ReportsOutputsThatStayOff) {
+  std::vector<fake_output_t> outputs {
+    {.supported = true, .mode = ORG_KDE_KWIN_DPMS_MODE_OFF, .obeys = false},
+  };
+
+  wake_outputs_on(outputs, true);
+
+  EXPECT_EQ(outputs[0].requests, std::vector<std::uint32_t> {ORG_KDE_KWIN_DPMS_MODE_ON});
+  EXPECT_TRUE(log_checker::line_contains("test_sunshine.log", "[wayland] A display stayed off"));
+}
