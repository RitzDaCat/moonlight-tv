+      g_autoptr(GVariant) reply = g_dbus_connection_call_sync(
+        conn,
+        "org.freedesktop.DBus",
+        "/org/freedesktop/DBus",
+        "org.freedesktop.DBus",
+        "RequestName",
+        g_variant_new("(su)", "org.freedesktop.ScreenSaver", 0),
+        G_VARIANT_TYPE("(u)"),
+        G_DBUS_CALL_FLAGS_NONE,
+        -1,
+        nullptr,
+        nullptr
+      );
+
+      thread = std::thread {[this]() {
+        while (running) {
+          g_main_context_iteration(context, TRUE);
+        }
+      }};
+    }
+
+    /**
+     * @brief Stop answering calls and leave the bus.
+     */
+    ~fake_screensaver_t() {
+      running = false;
+      g_main_context_wakeup(context);
+      thread.join();
+
+      g_dbus_connection_close_sync(conn, nullptr, nullptr);
+      g_object_unref(conn);
+      g_main_context_unref(context);
+      g_dbus_node_info_unref(node);
+    }
+
+    fake_screensaver_t(const fake_screensaver_t &) = delete;
+    fake_screensaver_t &operator=(const fake_screensaver_t &) = delete;
+
+    /**
+     * @brief Get the calls answered so far.
+     *
+     * @return Each call with its arguments.
+     */
+    std::vector<std::string> calls() {
+      std::scoped_lock lock {mutex};
+      return calls_answered;
+    }
+
+  private:
+    /**
+     * @brief Answer `Inhibit` with cookie 7 and record each call.
+     *
+     * @param connection Connection the call came in on.
+     * @param sender Unique name of the caller.
+     * @param object_path Object path of the call.
+     * @param interface_name Interface of the call.
+     * @param method_name Method called.
+     * @param parameters Arguments of the call.
+     * @param invocation Invocation to answer.
+     * @param user_data The fake service.
+     */
+    static void handle_method_call(GDBusConnection *connection, const gchar *sender, const gchar *object_path, const gchar *interface_name, const gchar *method_name, GVariant *parameters, GDBusMethodInvocation *invocation, gpointer user_data) {
+      auto self = static_cast<fake_screensaver_t *>(user_data);
+      std::scoped_lock lock {self->mutex};
+
+      if (!g_strcmp0(method_name, "Inhibit")) {
+        const gchar *application;
+        const gchar *reason;
+        g_variant_get(parameters, "(&s&s)", &application, &reason);
+        self->calls_answered.push_back(std::string {"Inhibit "} + application + ", " + reason);
+        g_dbus_method_invocation_return_value(invocation, g_variant_new("(u)", 7));
+        return;
+      }
+
+      std::uint32_t cookie;
+      g_variant_get(parameters, "(u)", &cookie);
+      self->calls_answered.push_back("UnInhibit " + std::to_string(cookie));
+      if (self->release_fails) {
+        g_dbus_method_invocation_return_dbus_error(invocation, "org.freedesktop.DBus.Error.Failed", "Unknown cookie");
+      } else {
+        g_dbus_method_invocation_return_value(invocation, nullptr);
+      }
+    }
+
+    const bool release_fails;  ///< Whether `UnInhibit` returns an error.
+    GMainContext *context {g_main_context_new()};  ///< Context the calls are answered on.
+    GDBusNodeInfo *node;  ///< Introspection data of the service.
+    GDBusConnection *conn;  ///< Connection that owns the ScreenSaver name.
+    std::atomic_bool running {true};  ///< Whether the thread keeps answering calls.
+    std::thread thread;  ///< Thread answering the calls.
+    std::mutex mutex;  ///< Guards calls_answered.
+    std::vector<std::string> calls_answered;  ///< Calls answered so far.
+  };
+
+  /**
+   * @brief Runs each test on a session bus of its own, which has no services to start.
+   */
+  class KeepDisplaysAwakeTest: public ::testing::Test {
+  protected:
+    /**
+     * @brief Start the session bus and point the session bus address at it.
+     */
+    void SetUp() override {
+      g_autofree gchar *daemon = g_find_program_in_path("dbus-daemon");
+      if (!daemon) {
+        GTEST_SKIP() << "dbus-daemon is not installed";
+      }
+
+      g_autofree gchar *tmp = g_dir_make_tmp("sunshine-test-dbus-XXXXXX", nullptr);
+      ASSERT_NE(tmp, nullptr);
+      dir = tmp;
+
+      const auto config = dir / "bus.conf";
+      std::ofstream {config} << "<busconfig><listen>unix:path=" << (dir / "bus").string() << "</listen>"
+                             << "<policy context='default'><allow send_destination='*'/><allow receive_sender='*'/><allow own='*'/></policy></busconfig>";
+
+      const auto config_arg = "--config-file=" + config.string();
+      bus = g_subprocess_new(G_SUBPROCESS_FLAGS_STDOUT_PIPE, nullptr, daemon, "--nofork", "--print-address", config_arg.c_str(), nullptr);
+      ASSERT_NE(bus, nullptr);
+
+      // The bus prints its address once it accepts connections
+      g_autoptr(GDataInputStream) out = g_data_input_stream_new(g_subprocess_get_stdout_pipe(bus));
+      g_autofree gchar *line = g_data_input_stream_read_line(out, nullptr, nullptr, nullptr);
+      ASSERT_NE(line, nullptr);
+      address = line;
+      lizardbyte::common::set_env("DBUS_SESSION_BUS_ADDRESS", address);
+    }
+
+    /**
+     * @brief Stop the session bus and remove its files.
+     */
+    void TearDown() override {
+      if (bus) {
+        stop_bus();
+        g_object_unref(bus);
+      }
+      if (!dir.empty()) {
+        std::filesystem::remove_all(dir);
+      }
+    }
+
+    /**
+     * @brief Stop the session bus.
+     */
+    void stop_bus() {
+      g_subprocess_force_exit(bus);
+      g_subprocess_wait(bus, nullptr, nullptr);
+    }
+
+    test_utils::env_restore_t session_bus {"DBUS_SESSION_BUS_ADDRESS"};  ///< Restores the session bus address.
+    std::filesystem::path dir;  ///< Directory holding the bus config and socket.
+    GSubprocess *bus {nullptr};  ///< Session bus of the test.
+    std::string address;  ///< Address of the session bus.
+  };
+}  // namespace
+
+TEST_F(KeepDisplaysAwakeTest, HoldsInhibitionUntilReleased) {
+  fake_screensaver_t screensaver {address.c_str(), false};
+
+  auto hold = platf::keep_displays_awake();
+  ASSERT_NE(hold, nullptr);
+  EXPECT_EQ(screensaver.calls(), std::vector<std::string> {"Inhibit Sunshine, Streaming"});
+
+  hold.reset();
+  EXPECT_EQ(screensaver.calls(), (std::vector<std::string> {"Inhibit Sunshine, Streaming", "UnInhibit 7"}));
+}
+
+TEST_F(KeepDisplaysAwakeTest, WarnsWhenReleaseFails) {
+  fake_screensaver_t screensaver {address.c_str(), true};
+
+  auto hold = platf::keep_displays_awake();
+  ASSERT_NE(hold, nullptr);
+  hold.reset();
+
+  EXPECT_EQ(screensaver.calls(), (std::vector<std::string> {"Inhibit Sunshine, Streaming", "UnInhibit 7"}));
+  EXPECT_TRUE(log_checker::line_contains("test_sunshine.log", "Couldn't release the display sleep inhibitor"));
+}
+
+TEST_F(KeepDisplaysAwakeTest, NoHoldWithoutScreenSaver) {
+  EXPECT_EQ(platf::keep_displays_awake(), nullptr);
+}
+
+TEST_F(KeepDisplaysAwakeTest, NoHoldWithoutSessionBus) {
+  stop_bus();
+
+  EXPECT_EQ(platf::keep_displays_awake(), nullptr);
+}
