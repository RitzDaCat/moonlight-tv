+/**
+ * @file tests/unit/test_fec_gfni.cpp
+ * @brief Independent GF polynomial oracle, byte guards and native-client-compatible recovery.
+ */
+#include "src/fec_encoder_cache.h"
+#include "src/fec_gfni.h"
+
+#include <array>
+#include <climits>
+#include <cstring>
+#include <gtest/gtest.h>
+#include <random>
+
+/** @brief Reference GF(256) polynomial multiply, independent of all affine lookup tables. */
+static unsigned char polynomial_product(unsigned a, unsigned b) {
+  unsigned product = 0;
+  for (unsigned bit = 0; bit < 8; ++bit) {
+    if (b & 1) {
+      product ^= a;
+    }
+    b >>= 1;
+    a <<= 1;
+    if (a & 256) {
+      a ^= 0x11d;
+    }
+  }
+  return static_cast<unsigned char>(product);
+}
+
+/** @brief Exhaust every coefficient and byte, including zero and identity transforms. */
+TEST(FecGfni, MatchesEveryPolynomialProduct) {
+  reed_solomon_init();
+  std::unique_ptr<reed_solomon, stream::fec::rs_deleter_t> rs {reed_solomon_new(1, 1)};
+  ASSERT_TRUE(rs);
+  std::array<unsigned char, 256> input {}, output {};
+  for (unsigned i = 0; i < 256; ++i) {
+    input[i] = i;
+  }
+  unsigned char *shards[] {input.data(), output.data()};
+  for (unsigned coefficient = 0; coefficient < 256; ++coefficient) {
+    rs->p[0] = coefficient;
+    ASSERT_EQ(stream::fec::gfni::encode(rs.get(), shards, 2, input.size()), 0);
+    for (unsigned x = 0; x < 256; ++x) {
+      ASSERT_EQ(output[x], polynomial_product(coefficient, x));
+    }
+  }
+}
+
+/** @brief Validate all public inputs before entering any vector or portable data path. */
+TEST(FecGfni, RejectsMalformedDimensionsAndPointers) {
+  reed_solomon_init();
+  std::unique_ptr<reed_solomon, stream::fec::rs_deleter_t> rs {reed_solomon_new(1, 1)};
+  ASSERT_TRUE(rs);
+  unsigned char input = 23, output = 0xcd;
+  unsigned char *shards[] {&input, &output};
+  EXPECT_LT(stream::fec::gfni::encode(nullptr, shards, 2, 1), 0);
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), nullptr, 2, 1), 0);
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 1, 1), 0);
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, 0), 0);
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, -1), 0);
+  shards[1] = nullptr;
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, 1), 0);
+  shards[1] = &output;
+  rs->ds = INT_MAX;
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, 1), 0);
+  rs->ds = 1;
+  rs->ps = INT_MAX;
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, 1), 0);
+  rs->ps = 1;
+  rs->ts = 1;
+  EXPECT_LT(stream::fec::gfni::encode(rs.get(), shards, 2, 1), 0);
+  EXPECT_EQ(output, 0xcd);
+}
+
+/** @brief Compare complete buffers, tails and erasure recovery against the unchanged client codec. */
+TEST(FecGfni, PreservesParityGuardsAndRecoveryWithPortableFallback) {
+  reed_solomon_init();
+  std::mt19937 random(0x40901344);
+  for (auto [data, parity] : {std::pair {1, 1}, {8, 2}, {32, 7}, {128, 26}, {200, 40}, {127, 128}, {254, 1}, {1, 254}}) {
+    std::unique_ptr<reed_solomon, stream::fec::rs_deleter_t> rs {reed_solomon_new(data, parity)};
+    ASSERT_TRUE(rs);
+    for (int bytes : {1, 3, 15, 31, 63, 64, 65, 127, 255, 256, 257, 1344, 1408, 9001}) {
+      for (bool native : {false, true}) {
+        constexpr unsigned guard = 67;
+        std::vector<std::vector<unsigned char>> expected(data + parity), actual(data + parity);
+        std::vector<unsigned char *> reference(data + parity), candidate(data + parity);
+        for (int i = 0; i < data + parity; ++i) {
+          expected[i].assign(bytes + guard * 2 + 3, 0xcd);
+          for (int x = 0; x < bytes; ++x) {
+            expected[i][guard + i % 4 + x] = random() & 255;
+          }
+          actual[i] = expected[i];
+          reference[i] = expected[i].data() + guard + i % 4;
+          candidate[i] = actual[i].data() + guard + i % 4;
+        }
+        ASSERT_EQ(reed_solomon_encode(rs.get(), reference.data(), data + parity, bytes), 0);
+        ASSERT_EQ(stream::fec::gfni::encode(rs.get(), candidate.data(), data + parity, bytes, native), 0);
+        ASSERT_EQ(expected, actual);
+        auto saved = actual;
+        std::vector<unsigned char> erased(data + parity, 0);
+        const int lost = std::min(data, std::max(1, parity / 2));
+        for (int i = 0; i < lost; ++i) {
+          erased[i] = 1;
+          std::memset(candidate[i], 0, bytes);
+        }
+        if (lost < parity) {
+          erased.back() = 1;
+          std::memset(candidate.back(), 0, bytes);
+        }
+        ASSERT_EQ(reed_solomon_decode(rs.get(), candidate.data(), erased.data(), data + parity, bytes), 0);
+        for (int i = 0; i < data; ++i) {
+          ASSERT_EQ(saved[i], actual[i]);
+        }
+      }
+    }
+  }
+}
