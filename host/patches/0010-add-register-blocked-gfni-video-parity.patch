+// SPDX-License-Identifier: GPL-3.0-only
+/**
+ * @file src/fec_gfni.h
+ * @brief Experimental register-blocked GF(256) parity, compatible with nanors matrices.
+ */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <rs.h>
+#if defined(__x86_64__) || defined(__i386__)
+  #include <gf2_8_affine_mat.h>
+  #include <immintrin.h>
+#endif
+
+namespace stream::fec::gfni {
+  /** @brief Query every feature required by the optional 512-bit GFNI implementation. */
+  inline bool available() {
+#if (defined(__x86_64__) || defined(__i386__)) && (defined(__GNUC__) || defined(__clang__))
+    static const bool supported = [] {
+      __builtin_cpu_init();
+      return __builtin_cpu_supports("avx512f") && __builtin_cpu_supports("avx512bw") && __builtin_cpu_supports("gfni");
+    }();
+    return supported;
+#else
+    return false;
+#endif
+  }
+#if (defined(__x86_64__) || defined(__i386__)) && (defined(__GNUC__) || defined(__clang__))
+  /**
+   * @brief Accumulate a parity-by-byte tile in registers instead of repeatedly storing partial parity.
+   * @tparam Rows Number of independent parity rows.
+   * @tparam Chunks Number of contiguous 64-byte vectors per row.
+   * @param rs Immutable nanors GF(256) coefficient matrix.
+   * @param shards Input data followed by output parity pointers, as in nanors.
+   * @param row First output parity row.
+   * @param offset Byte offset into every shard.
+   * @param tail Valid bytes for the one-vector tail; full tiles pass 64.
+   */
+  template<unsigned Rows, unsigned Chunks>
+  __attribute__((target("avx512f,avx512bw,gfni"))) inline void tile(const reed_solomon *rs, unsigned char **shards, unsigned row, unsigned offset, unsigned tail = 64) {
+    __m512i accum[Rows][Chunks];
+    const __mmask64 mask = tail == 64 ? ~__mmask64(0) : (__mmask64(1) << tail) - 1;
+    for (unsigned p = 0; p < Rows; ++p) {
+      for (unsigned c = 0; c < Chunks; ++c) {
+        accum[p][c] = _mm512_setzero_si512();
+      }
+    }
+    for (int input = 0; input < rs->ds; ++input) {
+      __m512i value[Chunks];
+      for (unsigned c = 0; c < Chunks; ++c) {
+        value[c] = _mm512_maskz_loadu_epi8(mask, shards[input] + offset + c * 64);
+      }
+      for (unsigned p = 0; p < Rows; ++p) {
+        const auto coefficient = rs->p[(row + p) * rs->ds + input];
+        const auto matrix = _mm512_set1_epi64(GF2_8_AFFINE_MAT[coefficient]);
+        for (unsigned c = 0; c < Chunks; ++c) {
+          accum[p][c] = _mm512_xor_si512(accum[p][c], _mm512_gf2p8affine_epi64_epi8(value[c], matrix, 0));
+        }
+      }
+    }
+    for (unsigned p = 0; p < Rows; ++p) {
+      for (unsigned c = 0; c < Chunks; ++c) {
+        _mm512_mask_storeu_epi8(shards[rs->ds + row + p] + offset + c * 64, mask, accum[p][c]);
+      }
+    }
+  }
+
+  /**
+   * @brief Cover a shard's full bytes and masked tail for a fixed parity group.
+   * @tparam Rows Independent parity rows retained in registers.
+   * @param rs Encoder coefficient matrix.
+   * @param shards Input/output shard pointers.
+   * @param row First output parity row.
+   * @param bytes Exact unpadded bytes per shard.
+   */
+  template<unsigned Rows>
+  __attribute__((target("avx512f,avx512bw,gfni"))) inline void rows(const reed_solomon *rs, unsigned char **shards, unsigned row, unsigned bytes) {
+    unsigned offset = 0;
+    for (; bytes - offset >= 256; offset += 256) {
+      tile<Rows, 4>(rs, shards, row, offset);
+    }
+    for (; bytes - offset >= 64; offset += 64) {
+      tile<Rows, 1>(rs, shards, row, offset);
+    }
+    if (offset != bytes) {
+      tile<Rows, 1>(rs, shards, row, offset, bytes - offset);
+    }
+  }
+
+  /**
+   * @brief Dispatch complete parity groups without function-pointer calls per data/parity pair.
+   * @param rs Encoder coefficient matrix.
+   * @param shards Input/output shard pointers.
+   * @param bytes Exact unpadded bytes per shard.
+   */
+  __attribute__((target("avx512f,avx512bw,gfni"))) inline void encode_native(const reed_solomon *rs, unsigned char **shards, unsigned bytes) {
+    unsigned row = 0;
+    for (; row + 4 <= unsigned(rs->ps); row += 4) {
+      rows<4>(rs, shards, row, bytes);
+    }
+    if (row + 2 <= unsigned(rs->ps)) {
+      rows<2>(rs, shards, row, bytes);
+      row += 2;
+    }
+    if (row < unsigned(rs->ps)) {
+      rows<1>(rs, shards, row, bytes);
+    }
+  }
+#endif
+  /**
+   * @brief Encode exact nanors parity, with a portable fallback on unsupported CPUs.
+   * @param rs Initialized coefficient matrix.
+   * @param shards Nonoverlapping data then parity pointers, with at least bytes readable/writable.
+   * @param count Number of provided shard pointers.
+   * @param bytes Bytes per shard; no padding or alignment is required.
+   * @param permit_native Allow the optional vector kernel; false exercises the portable fallback.
+   * @return Zero on success, negative on malformed dimensions or null shard pointers.
+   */
+  inline int encode(reed_solomon *rs, unsigned char **shards, int count, int bytes, bool permit_native = true) {
+    if (!rs || !shards || rs->ds <= 0 || rs->ds > DATA_SHARDS_MAX || rs->ps <= 0 || rs->ps > DATA_SHARDS_MAX || rs->ts != rs->ds + rs->ps || rs->ts > DATA_SHARDS_MAX || count < rs->ts || bytes <= 0) {
+      return -1;
+    }
+    for (int i = 0; i < rs->ts; ++i) {
+      if (!shards[i]) {
+        return -1;
+      }
+    }
+#if (defined(__x86_64__) || defined(__i386__)) && (defined(__GNUC__) || defined(__clang__))
+    if (permit_native && available()) {
+      encode_native(rs, shards, unsigned(bytes));
+      return 0;
+    }
+#endif
+    return reed_solomon_encode(rs, shards, count, bytes);
+  }
+}  // namespace stream::fec::gfni
