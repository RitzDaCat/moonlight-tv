+  int bind_encoder_stream_before_open(AVHWFramesContext *frames, stream_t &stream, std::shared_ptr<AVBufferRef> &device_owner) {
+    if (!cdf || !frames || !frames->device_ref || !frames->device_ctx || frames->device_ctx->type != AV_HWDEVICE_TYPE_CUDA || !frames->device_ctx->hwctx) {
+      return -1;
+    }
+    auto target = static_cast<AVCUDADeviceContext *>(frames->device_ctx->hwctx);
+    if (!target->cuda_ctx) {
+      return -1;
+    }
+    AVCUDADeviceContext *previous = nullptr;
+    if (stream) {
+      if (!device_owner) {
+        return -1;
+      }
+      auto old_device = reinterpret_cast<AVHWDeviceContext *>(device_owner->data);
+      if (old_device->type != AV_HWDEVICE_TYPE_CUDA || !old_device->hwctx) {
+        return -1;
+      }
+      previous = static_cast<AVCUDADeviceContext *>(old_device->hwctx);
+      if (previous->cuda_ctx != target->cuda_ctx) {
+        return -1;
+      }
+    }
+    auto retained = av_buffer_ref(frames->device_ref);
+    if (!retained) {
+      return -1;
+    }
+    std::shared_ptr<AVBufferRef> next_owner(retained, [](AVBufferRef *ref) {
+      av_buffer_unref(&ref);
+    });
+    CU_CHECK(cdf->cuCtxPushCurrent(target->cuda_ctx), "Couldn't enter encoder CUDA context");
+    CUcontext popped = nullptr;
+    auto pop = util::fail_guard([&]() {
+      CU_CHECK_IGNORE(cdf->cuCtxPopCurrent(&popped), "Couldn't leave encoder CUDA context");
+    });
+    auto next_stream = make_stream(1 /* cudaStreamNonBlocking */);
+    if (!next_stream) {
+      return -1;
+    }
+    if (previous && previous->stream == stream.get()) {
+      previous->stream = nullptr;
+    }
+    stream = std::move(next_stream);
+    device_owner = std::move(next_owner);
+    target->stream = stream.get();
+    return 0;
+  }
