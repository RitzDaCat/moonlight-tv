+// SPDX-License-Identifier: GPL-3.0-only
+/** @file test_cuda_encoder_stream.cpp
+ * @brief Real CUDA binding, rebinding, context validation and lifetime checks.
+ */
+#ifdef SUNSHINE_BUILD_CUDA
+  #include <dlfcn.h>
+  #include <ffnvcodec/dynlink_loader.h>
+  #include <gtest/gtest.h>
+extern "C" {
+  #include <libavutil/hwcontext_cuda.h>
+}
+  #include "src/platform/linux/cuda.h"
+  #include "src/video.h"
+
+/** @brief Reject incomplete bindings without needing a GPU or modifying ownership. */
+TEST(CudaEncoderStream, RejectsIncompleteFrames) {
+  std::shared_ptr<AVBufferRef> device_owner;
+  cuda::stream_t stream;
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(nullptr, stream, device_owner), 0);
+  EXPECT_LT(cuda::activate_encoder_context(nullptr), 0);
+  AVHWFramesContext empty {};
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(&empty, stream, device_owner), 0);
+  EXPECT_LT(cuda::activate_encoder_context(&empty), 0);
+  EXPECT_FALSE(stream);
+  EXPECT_FALSE(device_owner);
+}
+
+/** @brief Use real nonblocking work while preserving device and previous-state invariants. */
+TEST(CudaEncoderStream, BindingRebindingAndDeviceLifetime) {
+  CudaFunctions *functions = nullptr;
+  if (cuda_load_functions(&functions, nullptr) != 0) {
+    GTEST_SKIP() << "CUDA entry points unavailable";
+  }
+  auto release_functions = util::fail_guard([&]() {
+    cuda_free_functions(&functions);
+  });
+  if (cuda::init() != 0) {
+    GTEST_SKIP() << "CUDA driver unavailable";
+  }
+  video::avcodec_buffer_t device;
+  if (av_hwdevice_ctx_create(&device, AV_HWDEVICE_TYPE_CUDA, nullptr, nullptr, 1) < 0) {
+    GTEST_SKIP() << "CUDA primary context unavailable";
+  }
+  video::avcodec_buffer_t frames_ref {av_hwframe_ctx_alloc(device.get())};
+  ASSERT_TRUE(frames_ref);
+  auto frames = reinterpret_cast<AVHWFramesContext *>(frames_ref->data);
+  frames->format = AV_PIX_FMT_CUDA;
+  frames->sw_format = AV_PIX_FMT_NV12;
+  frames->width = frames->height = 64;
+  ASSERT_EQ(av_hwframe_ctx_init(frames_ref.get()), 0);
+  auto cuda_device = static_cast<AVCUDADeviceContext *>(frames->device_ctx->hwctx);
+  using set_current_t = CUresult(CUDAAPI *)(CUcontext);
+  auto set_current = reinterpret_cast<set_current_t>(dlsym(functions->lib, "cuCtxSetCurrent"));
+  ASSERT_NE(set_current, nullptr);
+  CUcontext previous = nullptr;
+  ASSERT_EQ(functions->cuCtxGetCurrent(&previous), CUDA_SUCCESS);
+  auto restore = util::fail_guard([&]() {
+    set_current(previous);
+  });
+  ASSERT_EQ(set_current(nullptr), CUDA_SUCCESS);
+  ASSERT_EQ(cuda::activate_encoder_context(frames), 0);
+  CUcontext active = nullptr;
+  ASSERT_EQ(functions->cuCtxGetCurrent(&active), CUDA_SUCCESS);
+  EXPECT_EQ(active, cuda_device->cuda_ctx);
+  std::shared_ptr<AVBufferRef> device_owner;
+  cuda::stream_t stream;
+  const int references = av_buffer_get_ref_count(frames->device_ref);
+  ASSERT_EQ(cuda::bind_encoder_stream_before_open(frames, stream, device_owner), 0);
+  ASSERT_TRUE(stream);
+  EXPECT_EQ(cuda_device->stream, stream.get());
+  EXPECT_EQ(av_buffer_get_ref_count(frames->device_ref), references + 1);
+  ASSERT_EQ(functions->cuCtxPushCurrent(cuda_device->cuda_ctx), CUDA_SUCCESS);
+  CUcontext popped = nullptr;
+  auto pop = util::fail_guard([&]() {
+    functions->cuCtxPopCurrent(&popped);
+  });
+  using stream_get_flags_t = CUresult (*)(CUstream, unsigned *);
+  auto stream_get_flags = reinterpret_cast<stream_get_flags_t>(dlsym(functions->lib, "cuStreamGetFlags"));
+  ASSERT_NE(stream_get_flags, nullptr);
+  unsigned flags = 0;
+  ASSERT_EQ(stream_get_flags(stream.get(), &flags), CUDA_SUCCESS);
+  EXPECT_EQ(flags & CU_STREAM_NON_BLOCKING, unsigned(CU_STREAM_NON_BLOCKING));
+
+  auto old_stream = stream.get();
+  ASSERT_EQ(cuda::bind_encoder_stream_before_open(frames, stream, device_owner), 0);
+  EXPECT_NE(old_stream, stream.get());
+  EXPECT_EQ(cuda_device->stream, stream.get());
+  EXPECT_EQ(av_buffer_get_ref_count(frames->device_ref), references + 1);
+
+  old_stream = stream.get();
+  AVHWDeviceContext wrong_device {};
+  wrong_device.type = AV_HWDEVICE_TYPE_VAAPI;
+  AVHWFramesContext wrong_frames = *frames;
+  wrong_frames.device_ctx = &wrong_device;
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(&wrong_frames, stream, device_owner), 0);
+  EXPECT_LT(cuda::activate_encoder_context(&wrong_frames), 0);
+  AVCUDADeviceContext wrong_cuda {};
+  wrong_device.type = AV_HWDEVICE_TYPE_CUDA;
+  wrong_device.hwctx = &wrong_cuda;
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(&wrong_frames, stream, device_owner), 0);
+  EXPECT_LT(cuda::activate_encoder_context(&wrong_frames), 0);
+  wrong_cuda.cuda_ctx = reinterpret_cast<CUcontext>(uintptr_t(1));
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(&wrong_frames, stream, device_owner), 0);
+  EXPECT_EQ(old_stream, stream.get());
+  EXPECT_EQ(cuda_device->stream, stream.get());
+
+  // A failed caller ownership state must not replace a functioning stream.
+  auto saved_owner = std::move(device_owner);
+  EXPECT_LT(cuda::bind_encoder_stream_before_open(frames, stream, device_owner), 0);
+  EXPECT_EQ(old_stream, stream.get());
+  device_owner = std::move(saved_owner);
+  // Drop the original references: the binding retains the actual device.
+  frames_ref.reset();
+  device.reset();
+  CUdeviceptr gpu = 0;
+  ASSERT_EQ(functions->cuMemAlloc(&gpu, sizeof(unsigned)), CUDA_SUCCESS);
+  unsigned *host = nullptr;
+  if (functions->cuMemHostAlloc(reinterpret_cast<void **>(&host), sizeof(*host), 0) != CUDA_SUCCESS) {
+    functions->cuMemFree(gpu);
+    FAIL() << "Pinned allocation failed";
+  }
+  auto free_buffers = util::fail_guard([&]() {
+    functions->cuStreamSynchronize(stream.get());
+    functions->cuMemFreeHost(host);
+    functions->cuMemFree(gpu);
+  });
+  ASSERT_EQ(functions->cuMemsetD8Async(gpu, 0x2a, sizeof(unsigned), stream.get()), CUDA_SUCCESS);
+  ASSERT_EQ(functions->cuMemcpyDtoHAsync(host, gpu, sizeof(unsigned), stream.get()), CUDA_SUCCESS);
+  ASSERT_EQ(functions->cuStreamSynchronize(stream.get()), CUDA_SUCCESS);
+  EXPECT_EQ(*host, 0x2a2a2a2au);
+}
+#endif
