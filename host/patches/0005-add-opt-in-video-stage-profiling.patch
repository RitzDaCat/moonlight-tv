diff --git a/src/video_latency_profile.h b/src/video_latency_profile.h
new file mode 100644
index 0000000..db84a84
--- /dev/null
+++ b/src/video_latency_profile.h
@@ -0,0 +1,175 @@
+/**
+ * @file src/video_latency_profile.h
+ * @brief Opt-in, bounded CPU-wall stage timing without per-frame logging or allocation.
+ */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <utility>
+
+namespace video_latency {
+  /** @brief Distinct wall-time boundaries; nested spans must not be summed. */
+  enum class stage {
+    kms_refresh,  ///< Metadata/export work, including work before the wire timestamp.
+    import,  ///< EGL source import.
+    rgb_prepare,  ///< Crop and cursor preparation.
+    gl_convert,  ///< GL submission, not GPU completion.
+    map,  ///< GL-to-CUDA map call including any blocking wait.
+    copy_unmap,  ///< CUDA plane-copy submission and unmap call.
+    convert_total,  ///< Total converter CPU wall time, including nested stages.
+    capture_to_consume,  ///< Capture age on encoder consumption.
+    encode_enqueue,  ///< Encoder send/drain and packet enqueue CPU wall time.
+    packet_queue,  ///< Encoded packet enqueue-to-consumer residence.
+    capture_to_broadcast,  ///< Capture age on broadcaster consumption.
+    count  ///< Number of stage identifiers.
+  };
+
+  /** @brief Single-owner timing accumulator. Disabled mode reads no clocks and allocates nothing. */
+  class profile_t {
+  public:
+    using clock = std::chrono::steady_clock;  ///< Shared monotonic clock domain.
+
+    /** @brief Read the opt-in switch once, at profile construction. */
+    static bool requested() {
+      auto value = std::getenv("SUNSHINE_PROFILE_VIDEO");
+      return value != nullptr && value[0] == '1' && value[1] == '\0';
+    }
+
+    /** @brief Construct an optionally enabled profile. @param enabled Allocate bounded timing storage if true. */
+    explicit profile_t(bool enabled = requested()):
+        data(enabled ? std::make_unique<data_t>() : nullptr) {}
+
+    /** @brief Return whether timing is active. */
+    bool enabled() const {
+      return bool(data);
+    }
+
+    /**
+     * @brief Add one nonnegative wall-time observation.
+     * @param id Stage measured.
+     * @param duration Elapsed time in the shared monotonic clock domain.
+     */
+    void observe(stage id, clock::duration duration) {
+      const auto index = static_cast<std::size_t>(id);
+      if (!data || index >= data->values.size() || duration < clock::duration::zero()) {
+        return;
+      }
+      auto &v = data->values[index];
+      auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(duration).count();
+      v.recent[v.count % v.recent.size()] = ns;
+      ++v.count;
+      v.total_ns += ns;
+      v.maximum_ns = std::max(v.maximum_ns, ns);
+    }
+
+    /** @brief Scoped wall-time measurement; the profile must outlive the scope. */
+    class scope_t {
+    public:
+      /** @brief Start timing if enabled. @param owner Profile owner. @param id Stage measured. */
+      scope_t(profile_t &owner, stage id):
+          profile(owner.enabled() ? &owner : nullptr),
+          id(id),
+          start(owner.enabled() ? clock::now() : clock::time_point {}) {}
+
+      scope_t(const scope_t &) = delete;
+
+      /** @brief Record elapsed wall time even when the operation throws. */
+      ~scope_t() {
+        if (profile) {
+          profile->observe(id, clock::now() - start);
+        }
+      }
+
+    private:
+      profile_t *profile;  ///< Owner, or null when disabled.
+      stage id;  ///< Stage measured.
+      clock::time_point start;  ///< Beginning of the synchronous call.
+    };
+
+    /** @brief Start a scoped measurement. @param id Stage measured. @return Scoped timer. */
+    scope_t scope(stage id) {
+      return scope_t {*this, id};
+    }
+
+    /**
+     * @brief Measure a synchronous call; asynchronous GPU completion is not inferred.
+     * @param id Stage measured.
+     * @param operation Operation to execute exactly once, including when disabled.
+     * @return The operation's unchanged return value.
+     */
+    template<class F>
+    decltype(auto) measure(stage id, F &&operation) {
+      auto timer = scope(id);
+      return std::forward<F>(operation)();
+    }
+
+    /** @brief Return sample count. @param id Stage inspected. */
+    std::uint64_t count(stage id) const {
+      auto index = static_cast<std::size_t>(id);
+      return data && index < data->values.size() ? data->values[index].count : 0;
+    }
+
+    /**
+     * @brief Format at teardown, outside the per-frame path. Quantiles cover the latest 512 samples.
+     * @param backend Constant backend label supplied by the caller.
+     * @return CPU-wall timing summary; empty when disabled or no samples exist.
+     */
+    std::string report(const char *backend) const {
+      if (!data) {
+        return {};
+      }
+      std::ostringstream out;
+      out << "Video CPU-wall profile backend=" << backend << " (nested spans; quantiles=last512; us):";
+      bool any = false;
+      for (std::size_t i = 0; i < data->values.size(); ++i) {
+        const auto &v = data->values[i];
+        if (!v.count) {
+          continue;
+        }
+        any = true;
+        auto copy = v.recent;
+        auto n = std::min<std::uint64_t>(v.count, copy.size());
+        std::sort(copy.begin(), copy.begin() + n);
+        out << ' ' << names[i] << "{n=" << v.count << ",avg=" << v.total_ns / v.count / 1000
+            << ",p50=" << copy[n / 2] / 1000. << ",p95=" << copy[n * 95 / 100] / 1000.
+            << ",p99=" << copy[n * 99 / 100] / 1000. << ",max=" << v.maximum_ns / 1000. << '}';
+      }
+      return any ? out.str() : std::string {};
+    }
+
+  private:
+    /** @brief Fixed-size recent sample ring with whole-session aggregate statistics. */
+    struct values_t {
+      std::array<std::int64_t, 512> recent {};  ///< Recent wall times in ns.
+      std::uint64_t count = 0;  ///< Whole-session sample count.
+      long double total_ns = 0;  ///< Aggregate time without integer-sum overflow.
+      std::int64_t maximum_ns = 0;  ///< Whole-session maximum.
+    };
+
+    /** @brief Storage allocated once only when explicitly enabled. */
+    struct data_t {
+      std::array<values_t, static_cast<std::size_t>(stage::count)> values;  ///< Per-stage sample storage.
+    };
+
+    std::unique_ptr<data_t> data;  ///< Single-thread-owned optional storage.
+    inline static constexpr std::array<const char *, static_cast<std::size_t>(stage::count)> names {
+      "kms_refresh",
+      "egl_import",
+      "rgb_prepare",
+      "gl_submit",
+      "cuda_map",
+      "cuda_copy_unmap",
+      "convert_total",
+      "capture_to_consume",
+      "encode_enqueue",
+      "packet_queue",
+      "capture_to_broadcast"
+    };  ///< Stable stage labels.
+  };
+}  // namespace video_latency
diff --git a/tests/unit/test_video_latency_profile.cpp b/tests/unit/test_video_latency_profile.cpp
new file mode 100644
index 0000000..10d331c
--- /dev/null
+++ b/tests/unit/test_video_latency_profile.cpp
@@ -0,0 +1,61 @@
+/**
+ * @file tests/unit/test_video_latency_profile.cpp
+ * @brief Verify opt-in timing boundaries, bounded reporting, and exception behavior.
+ */
+#include <gtest/gtest.h>
+#include <src/video_latency_profile.h>
+#include <stdexcept>
+
+TEST(VideoLatencyProfile, DisabledStillExecutesOperationsAndCollectsNothing) {
+  video_latency::profile_t profile(false);
+  int calls = 0;
+  EXPECT_EQ(profile.measure(video_latency::stage::map, [&] {
+    ++calls;
+    return 7;
+  }),
+            7);
+  profile.observe(video_latency::stage::map, std::chrono::seconds(1));
+  EXPECT_EQ(calls, 1);
+  EXPECT_FALSE(profile.enabled());
+  EXPECT_EQ(profile.count(video_latency::stage::map), 0);
+  EXPECT_TRUE(profile.report("test").empty());
+}
+
+TEST(VideoLatencyProfile, RecentQuantilesAndWholeSessionMeanHaveExplicitBoundaries) {
+  video_latency::profile_t profile(true);
+  for (int i = 0; i < 1024; ++i) {
+    profile.observe(video_latency::stage::map, std::chrono::microseconds(i));
+  }
+  auto report = profile.report("test");
+  EXPECT_EQ(profile.count(video_latency::stage::map), 1024);
+  EXPECT_NE(report.find("avg=511.5"), std::string::npos);
+  EXPECT_NE(report.find("p50=768"), std::string::npos);
+  EXPECT_NE(report.find("p95=998"), std::string::npos);
+  EXPECT_NE(report.find("max=1023"), std::string::npos);
+}
+
+TEST(VideoLatencyProfile, InvalidAndNegativeSamplesAreIgnored) {
+  video_latency::profile_t profile(true);
+  profile.observe(video_latency::stage::count, std::chrono::seconds(1));
+  profile.observe(video_latency::stage::map, -std::chrono::seconds(1));
+  EXPECT_EQ(profile.count(video_latency::stage::count), 0);
+  EXPECT_TRUE(profile.report("test").empty());
+}
+
+TEST(VideoLatencyProfile, RecordsExceptionsAndPreservesReferenceAndVoidReturns) {
+  video_latency::profile_t profile(true);
+  int value = 3;
+  int &reference = profile.measure(video_latency::stage::map, [&]() -> int & {
+    return value;
+  });
+  EXPECT_EQ(&reference, &value);
+  profile.measure(video_latency::stage::map, [&] {
+    value = 4;
+  });
+  EXPECT_EQ(value, 4);
+  EXPECT_THROW(profile.measure(video_latency::stage::map, []() -> int {
+    throw std::runtime_error("test");
+  }),
+               std::runtime_error);
+  EXPECT_EQ(profile.count(video_latency::stage::map), 3);
+}
