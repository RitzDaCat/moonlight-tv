diff --git a/src/video_packet_size.h b/src/video_packet_size.h
new file mode 100644
index 00000000..bdbf30d7
--- /dev/null
+++ b/src/video_packet_size.h
@@ -0,0 +1,54 @@
+/**
+ * @file src/video_packet_size.h
+ * @brief Validate negotiated video packet sizes before packet arithmetic.
+ */
+#pragma once
+
+// standard includes
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+// local includes
+#include "config.h"
+
+namespace stream {
+  inline constexpr std::size_t VIDEO_RTP_HEADER_SIZE = 16;
+  inline constexpr std::size_t VIDEO_ENCRYPTION_PREFIX_SIZE = 32;
+  inline constexpr std::size_t MAX_VIDEO_UDP_PAYLOAD_SIZE = 65507;
+
+  /**
+   * @brief Parse a packet size without narrowing or accepting trailing text.
+   */
+  inline std::optional<int> parse_video_packet_size(std::string_view text) {
+    if (text.empty()) {
+      return std::nullopt;
+    }
+    std::int64_t value {};
+    const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (error != std::errc {} || end != text.data() + text.size() || value < config::PACKETSIZE_MIN || value > config::PACKETSIZE_MAX) {
+      return std::nullopt;
+    }
+    return static_cast<int>(value);
+  }
+
+  /**
+   * @brief Return positive video bytes per packet that fit an IPv4 UDP datagram.
+   *
+   * Packet size includes the GameStream video header, but excludes the RTP
+   * header and optional encryption prefix added by the video broadcaster.
+   */
+  inline std::optional<std::size_t> video_packet_payload_size(std::int64_t packet_size, std::size_t video_header_size, bool encrypted) {
+    if (packet_size < config::PACKETSIZE_MIN || packet_size > config::PACKETSIZE_MAX) {
+      return std::nullopt;
+    }
+    const auto size = static_cast<std::size_t>(packet_size);
+    const auto prefix_size = encrypted ? VIDEO_ENCRYPTION_PREFIX_SIZE : 0;
+    if (size <= video_header_size || size + VIDEO_RTP_HEADER_SIZE + prefix_size > MAX_VIDEO_UDP_PAYLOAD_SIZE) {
+      return std::nullopt;
+    }
+    return size - video_header_size;
+  }
+}  // namespace stream
diff --git a/tests/unit/test_video_packet_size.cpp b/tests/unit/test_video_packet_size.cpp
new file mode 100644
index 00000000..dff3169b
--- /dev/null
+++ b/tests/unit/test_video_packet_size.cpp
@@ -0,0 +1,51 @@
+/**
+ * @file tests/unit/test_video_packet_size.cpp
+ * @brief Video packet negotiation and UDP geometry regressions.
+ */
+#include <gtest/gtest.h>
+#include <src/video_packet_size.h>
+
+extern "C" {
+#include <moonlight-common-c/src/Limelight.h>
+#include <moonlight-common-c/src/Video.h>
+}
+
+static_assert(sizeof(NV_VIDEO_PACKET) == 16);
+static_assert(stream::VIDEO_RTP_HEADER_SIZE == MAX_RTP_HEADER_SIZE);
+static_assert(stream::VIDEO_ENCRYPTION_PREFIX_SIZE == sizeof(ENC_VIDEO_HEADER));
+
+TEST(VideoPacketSizeTests, RejectsUndersizedMalformedAndNarrowingInputs) {
+  for (const auto text : {"", "0", "16", "-1", "199", "1392oops", "65536", "4294968688", "9223372036854775808"}) {
+    EXPECT_FALSE(stream::parse_video_packet_size(text)) << text;
+  }
+  for (const auto size : {-1, 0, 16, 199, 65536}) {
+    EXPECT_FALSE(stream::video_packet_payload_size(size, 16, false)) << size;
+    EXPECT_FALSE(stream::video_packet_payload_size(size, 16, true)) << size;
+  }
+}
+
+TEST(VideoPacketSizeTests, PreservesNormalPacketPayloadsAndConfiguredBounds) {
+  EXPECT_EQ(stream::parse_video_packet_size("200"), 200);
+  EXPECT_EQ(stream::parse_video_packet_size("1392"), 1392);
+  EXPECT_EQ(stream::parse_video_packet_size("1456"), 1456);
+  EXPECT_EQ(stream::parse_video_packet_size("65535"), 65535);
+  EXPECT_EQ(stream::video_packet_payload_size(200, 16, false), 184);
+  EXPECT_EQ(stream::video_packet_payload_size(1392, 16, false), 1376);
+  EXPECT_EQ(stream::video_packet_payload_size(1392, 16, true), 1376);
+  EXPECT_EQ(stream::video_packet_payload_size(1456, 16, true), 1440);
+}
+
+TEST(VideoPacketSizeTests, ReservesRtpAndEncryptionBytesWithinUdpLimit) {
+  // UDP's IPv4 payload limit is 65507 bytes, including every video header.
+  EXPECT_EQ(stream::video_packet_payload_size(65491, 16, false), 65475);
+  EXPECT_FALSE(stream::video_packet_payload_size(65492, 16, false));
+  EXPECT_EQ(stream::video_packet_payload_size(65459, 16, true), 65443);
+  EXPECT_FALSE(stream::video_packet_payload_size(65460, 16, true));
+  EXPECT_FALSE(stream::video_packet_payload_size(65535, 16, false));
+  EXPECT_FALSE(stream::video_packet_payload_size(65535, 16, true));
+}
+
+TEST(VideoPacketSizeTests, RejectsHeadersWithoutPositiveVideoPayload) {
+  EXPECT_FALSE(stream::video_packet_payload_size(200, 200, false));
+  EXPECT_FALSE(stream::video_packet_payload_size(200, 201, false));
+}
