+// SPDX-License-Identifier: GPL-3.0-only
+/** @file dmabuf_cache_test.cpp
+ * @brief Identity, layout, failure atomicity, LRU and descriptor lifetime
+ * regressions.
+ */
+#include "src/platform/linux/dmabuf_import_cache.h"
+#include <cstdio>
+#ifndef DMABUF_CACHE_STANDALONE
+#include <gtest/gtest.h>
+#endif
+#include <filesystem>
+#include <memory>
+#include <stdexcept>
+#include <string>
+/** @brief Reject a failed regression check. */
+static void expect(bool ok, const char *why) {
+  if (!ok)
+    throw std::runtime_error(why);
+}
+/** @brief Auto-remove unnamed temporary files even when an assertion throws. */
+struct Closer {
+  void operator()(FILE *f) const { std::fclose(f); }
+};
+/** @brief Imported object whose teardown must precede closing retained
+ * descriptors. */
+struct Value {
+  int fd, id;
+  bool *lifetime_ok;
+  Value(int f, int n, bool *ok) : fd(f), id(n), lifetime_ok(ok) {}
+  Value(const Value &) = delete;
+  Value &operator=(const Value &) = delete;
+  Value(Value &&b) noexcept
+      : fd(std::exchange(b.fd, -1)), id(b.id), lifetime_ok(b.lifetime_ok) {}
+  Value &operator=(Value &&b) noexcept {
+    if (this != &b) {
+      verify();
+      fd = std::exchange(b.fd, -1);
+      id = b.id;
+      lifetime_ok = b.lifetime_ok;
+    }
+    return *this;
+  }
+  void verify() {
+    if (fd >= 0) {
+      struct stat s{};
+      if (fstat(fd, &s))
+        *lifetime_ok = false;
+    }
+  }
+  ~Value() { verify(); }
+};
+/** @brief Count open descriptors to detect miss/failure/clear leaks. */
+static unsigned fds() {
+  unsigned n = 0;
+  for (auto &item : std::filesystem::directory_iterator("/proc/self/fd")) {
+    (void)item;
+    ++n;
+  }
+  return n;
+}
+/** @brief Exercise eight independent cache/resource invariants. */
+static unsigned run_cache_regressions() {
+  auto before = fds();
+  bool lifetime_ok = true;
+  unsigned scenarios = 0;
+  {
+    std::array<std::unique_ptr<FILE, Closer>, 4> files;
+    for (auto &f : files) {
+      f.reset(std::tmpfile());
+      expect(bool(f), "tmpfile failed");
+    }
+    auto surface = [&](unsigned i) {
+      dma_import::surface s;
+      s.width = 1920;
+      s.height = 1080;
+      s.fourcc = 42;
+      s.modifier = 7;
+      s.fds[0] = fileno(files[i].get());
+      s.pitches[0] = 7680;
+      return s;
+    };
+    int created = 0;
+    bool fail = false;
+    auto importer = [&](const dma_import::surface &s) -> std::optional<Value> {
+      if (fail)
+        return std::nullopt;
+      return std::optional<Value>(std::in_place, s.fds[0], ++created,
+                                  &lifetime_ok);
+    };
+    {
+      dma_import::cache<Value, 2> cache;
+      auto a = surface(0), b = surface(1), c = surface(2), d = surface(3);
+      int aid = cache.get(a, importer)->id, bid = cache.get(b, importer)->id;
+      expect(cache.get(a, importer)->id == aid, "Cache hit rebuilt view");
+      cache.get(c, importer);
+      expect(cache.get(a, importer)->id == aid, "MRU hit was evicted");
+      expect(cache.get(b, importer)->id != bid, "LRU miss reused evicted view");
+      ++scenarios;
+      auto keep = cache.get(a, importer)->id;
+      auto count = fds();
+      fail = true;
+      expect(cache.get(d, importer) == nullptr,
+             "Failed importer returned view");
+      expect(fds() == count, "Failed import leaked pinned descriptors");
+      fail = false;
+      expect(cache.get(a, importer)->id == keep,
+             "Failed import evicted a valid view");
+      ++scenarios;
+      // Every layout change must invalidate even when the exported object is
+      // unchanged.
+      for (unsigned change = 0; change < 6; ++change) {
+        auto x = a;
+        switch (change) {
+        case 0:
+          ++x.width;
+          break;
+        case 1:
+          ++x.height;
+          break;
+        case 2:
+          ++x.fourcc;
+          break;
+        case 3:
+          ++x.modifier;
+          break;
+        case 4:
+          ++x.pitches[0];
+          break;
+        case 5:
+          ++x.offsets[0];
+          break;
+        }
+        int previous = created;
+        expect(cache.get(x, importer) && created == previous + 1,
+               "Layout change reused old view");
+      }
+      ++scenarios;
+      auto multi = a;
+      multi.fds[1] = b.fds[0];
+      multi.pitches[1] = 3840;
+      auto id = cache.get(multi, importer)->id;
+      multi.fds[1] = c.fds[0];
+      expect(cache.get(multi, importer)->id != id,
+             "Second plane identity ignored");
+      ++scenarios;
+      // Reuse the same integer descriptor for a different object; the old one
+      // is pinned.
+      cache.clear();
+      auto original = cache.get(a, importer)->id;
+      expect(dup2(b.fds[0], a.fds[0]) == a.fds[0], "dup2 failed");
+      expect(cache.get(a, importer)->id != original,
+             "Integer FD reuse produced stale hit");
+      ++scenarios;
+      // Unknown identities must remain uncached; callback failure must not
+      // return stale fallback.
+      auto unknown = a;
+      unknown.fds[0] = -1;
+      int start = created;
+      expect(cache.get(unknown, importer) && cache.get(unknown, importer) &&
+                 created == start + 2,
+             "Unknown identity was cached");
+      fail = true;
+      expect(!cache.get(unknown, importer),
+             "Fallback failure returned old value");
+      fail = false;
+      ++scenarios;
+      cache.clear();
+      expect(lifetime_ok, "Descriptors closed before imported values");
+      ++scenarios;
+    }
+  }
+  expect(lifetime_ok && fds() == before,
+         "Cache teardown leaked descriptors or invalidated view lifetime");
+  ++scenarios;
+  return scenarios;
+}
+#ifdef DMABUF_CACHE_STANDALONE
+/** @brief Run without framework dependencies for focused sanitizer validation.
+ */
+int main() {
+  try {
+    std::printf("%u regression scenarios passed\n", run_cache_regressions());
+    return 0;
+  } catch (const std::exception &e) {
+    std::fprintf(stderr, "%s\n", e.what());
+    return 1;
+  }
+}
+#else
+TEST(DmabufImportCache,
+     PreservesIdentityLayoutFailureAtomicityAndDescriptorLifetimes) {
+  EXPECT_EQ(run_cache_regressions(), 8u);
+}
+#endif
