+// SPDX-License-Identifier: GPL-3.0-only
+/** @file dmabuf_import_cache.h
+ * @brief Bounded owner-thread cache of imported DMA-BUF views with pinned
+ * identity.
+ */
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <fcntl.h>
+#include <memory>
+#include <optional>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <utility>
+
+namespace dma_import {
+/** @brief Full source layout; negative descriptors mark unused planes. */
+struct surface {
+  int width = 0, height = 0;
+  std::uint32_t fourcc = 0;
+  std::uint64_t modifier = 0;
+  std::array<int, 4> fds{-1, -1, -1, -1};
+  std::array<std::uint32_t, 4> pitches{}, offsets{};
+};
+/** @brief Hold exported objects alive so inode reuse cannot produce a false
+ * hit. */
+struct owned_fds {
+  std::array<int, 4> values{-1, -1, -1, -1};
+  owned_fds() = default;
+  owned_fds(const owned_fds &) = delete;
+  owned_fds &operator=(const owned_fds &) = delete;
+  ~owned_fds() {
+    for (int fd : values)
+      if (fd >= 0)
+        close(fd);
+  }
+};
+/** @brief Validate identity/layout on every lookup; import only on bounded
+ * misses. Importer receives descriptors owned by the new entry and returns
+ * optional<Value>. Values and retained descriptors are released on the owning
+ * graphics thread. Return pointers survive until eviction, clear, or the next
+ * uncached fallback.
+ */
+template <class Value, std::size_t Capacity = 4> class cache {
+  static_assert(Capacity > 0);
+  /** @brief Include every plane's object identity and byte interpretation. */
+  struct key {
+    surface layout;
+    std::array<dev_t, 4> devices{};
+    std::array<ino_t, 4> inodes{};
+    std::array<bool, 4> used{};
+    bool operator==(const key &b) const {
+      return layout.width == b.layout.width &&
+             layout.height == b.layout.height &&
+             layout.fourcc == b.layout.fourcc &&
+             layout.modifier == b.layout.modifier &&
+             layout.pitches == b.layout.pitches &&
+             layout.offsets == b.layout.offsets && devices == b.devices &&
+             inodes == b.inodes && used == b.used;
+    }
+  };
+  /** @brief Value is destroyed before its pinned descriptors. */
+  struct entry {
+    key identity;
+    owned_fds descriptors;
+    std::optional<Value> value;
+  };
+  std::array<std::unique_ptr<entry>, Capacity> entries{};
+  std::array<std::size_t, Capacity> order{};
+  std::optional<Value> fallback;
+  /** @brief Reject unknown identities and preserve the original uncached route.
+   */
+  static std::optional<key> identify(const surface &source) {
+    if (source.width <= 0 || source.height <= 0)
+      return std::nullopt;
+    key result;
+    result.layout = source;
+    bool any = false;
+    for (std::size_t p = 0; p < 4; ++p) {
+      if (source.fds[p] < 0)
+        continue;
+      struct stat info{};
+      if (fstat(source.fds[p], &info) || info.st_ino == 0)
+        return std::nullopt;
+      result.used[p] = true;
+      result.devices[p] = info.st_dev;
+      result.inodes[p] = info.st_ino;
+      any = true;
+    }
+    return any ? std::optional<key>(result) : std::nullopt;
+  }
+  /** @brief Promote an array slot without allocating or a wrapping age counter.
+   */
+  void promote(std::size_t position) {
+    auto slot = order[position];
+    std::move_backward(order.begin(), order.begin() + position,
+                       order.begin() + position + 1);
+    order[0] = slot;
+  }
+
+public:
+  cache() {
+    for (std::size_t i = 0; i < Capacity; ++i)
+      order[i] = i;
+  }
+  cache(const cache &) = delete;
+  cache &operator=(const cache &) = delete;
+  /** @brief Release all held imports while the owner graphics context is
+   * current. */
+  void clear() {
+    for (auto &item : entries)
+      item.reset();
+    fallback.reset();
+  }
+  /** @brief Obtain an identity-safe import, preserving old entries if import
+   * fails. */
+  template <class Importer>
+  const Value *get(const surface &source, Importer &&importer) {
+    auto identity = identify(source);
+    if (!identity) {
+      auto value = importer(source);
+      fallback = std::move(value);
+      return fallback ? &*fallback : nullptr;
+    }
+    for (std::size_t position = 0; position < Capacity; ++position) {
+      auto &item = entries[order[position]];
+      if (item && item->identity == *identity) {
+        auto result = &*item->value;
+        promote(position);
+        return result;
+      }
+    }
+    auto candidate = std::make_unique<entry>();
+    surface retained = source;
+    for (std::size_t p = 0; p < 4; ++p) {
+      if (source.fds[p] < 0)
+        continue;
+      int fd = fcntl(source.fds[p], F_DUPFD_CLOEXEC, 0);
+      if (fd < 0) {
+        auto value = importer(source);
+        fallback = std::move(value);
+        return fallback ? &*fallback : nullptr;
+      }
+      candidate->descriptors.values[p] = retained.fds[p] = fd;
+    }
+    auto retained_identity = identify(retained);
+    if (!retained_identity || !(*identity == *retained_identity))
+      return nullptr;
+    candidate->value = importer(retained);
+    if (!candidate->value)
+      return nullptr;
+    candidate->identity = *identity;
+    // Prefer an empty slot; eviction occurs only after successful import.
+    std::size_t position = Capacity - 1;
+    for (std::size_t p = 0; p < Capacity; ++p)
+      if (!entries[order[p]]) {
+        position = p;
+        break;
+      }
+    entries[order[position]] = std::move(candidate);
+    auto result = &*entries[order[position]]->value;
+    promote(position);
+    return result;
+  }
+};
+} // namespace dma_import
